# Falco LMS API — single backend URL for server routes and client document URLs.
# No trailing slash. Required: copy to `.env.local` for local dev (see `lib/falco-api.ts`).
FALCO_API_BASE_URL=https://falco.goldencreations.online

# Optional: minimum access-token cookie lifetime in seconds (e.g. 604800 = 7 days).
# FALCO_SESSION_MIN_AGE_SECONDS=604800
