# Falco LMS API — server-side Next.js routes (`/api/login`, proxies, etc.).
# No trailing slash. If unset, the app defaults to the URL below (see `lib/falco-api.ts`).
# For local runs: copy this file to `.env.local` or export the variable before `next start`.
FALCO_API_BASE_URL=https://falcobackend.habitek.co.tz

# Optional: minimum access-token cookie lifetime in seconds (e.g. 604800 = 7 days).
# FALCO_SESSION_MIN_AGE_SECONDS=604800
